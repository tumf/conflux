{
    // Conflux Configuration - Project-specific overrides

    // Lifecycle hooks
    "hooks": {
        // Rebuild indexes after merge completion
        //"on_merged": "make bump-patch && make index"
        "on_merged": {
            "command": "make bump-patch",
            "timeout": 600,
            "continue_on_failure": false,
            "git_commit_no_verify": true,
            "max_retries": 0,
            "retry_delay_secs": 5,
        },
    },

    "analyze_command": "pi --no-session --model kani/kani/auto -p '{prompt}'",
    "apply_command": "pi --no-session --model kani/kani/code -p '{prompt}'",
    "apply_escalation_command": "pi --no-session --model kani/kani/code -p '{prompt}'",
    "apply_stall_diagnose_command": "pi --no-session --model kani/kani/code -p '{prompt}'",
    "acceptance_command": "pi --no-session --model kani/kani/deep -p '{prompt}'",
    "archive_command": "pi --no-session --model kani/kani/auto -p '{prompt}'",
    "resolve_command": "pi --no-session --model kani/kani/auto -p '{prompt}'",
}
